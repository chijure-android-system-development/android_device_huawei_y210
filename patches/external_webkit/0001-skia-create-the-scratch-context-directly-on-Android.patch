From 14df6c78c42cd296d580609fae3da99c300dfd46 Mon Sep 17 00:00:00 2001
From: Juan Manuel Reategui Solis <reateguisolisjm@gmail.com>
Date: Sun, 18 Oct 2026 23:11:05 -0500
Subject: [PATCH] skia: create the scratch context directly on Android

ImageBufferAndroid refuses to allocate while ActivityManager reports
lowMemory, which is the normal state on a 256MB device such as the
Huawei Y210. scratchContext() keeps the result in a static and never
checks it, so a first call under memory pressure left it NULL for the
life of the process and every stroked SVG path crashed the browser in
ImageBuffer::context() (fault addr 0x10).

A 1x1 offscreen context needs no memory check; create it directly.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Id3976bed722ea8cb1e7f1b062ff9ed766ca904ff
---
 Source/WebCore/platform/graphics/skia/SkiaUtils.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/Source/WebCore/platform/graphics/skia/SkiaUtils.cpp b/Source/WebCore/platform/graphics/skia/SkiaUtils.cpp
index da837933a..618f21c82 100644
--- a/Source/WebCore/platform/graphics/skia/SkiaUtils.cpp
+++ b/Source/WebCore/platform/graphics/skia/SkiaUtils.cpp
@@ -248,10 +248,19 @@ bool SkPathContainsPoint(SkPath* originalPath, const FloatPoint& point, SkPath::
 
 GraphicsContext* scratchContext()
 {
+#if PLATFORM(ANDROID)
+    // ImageBufferAndroid refuses to allocate while ActivityManager reports
+    // lowMemory, and this static would then stay NULL for the life of the
+    // process, crashing every stroked SVG path. A 1x1 context needs no
+    // memory check, so create it directly.
+    static GraphicsContext* scratch = GraphicsContext::createOffscreenContext(1, 1);
+    return scratch;
+#else
     static ImageBuffer* scratch = ImageBuffer::create(IntSize(1, 1)).leakPtr();
     // We don't bother checking for failure creating the ImageBuffer, since our
     // ImageBuffer initializer won't fail.
     return scratch->context();
+#endif
 }
 
 }  // namespace WebCore
