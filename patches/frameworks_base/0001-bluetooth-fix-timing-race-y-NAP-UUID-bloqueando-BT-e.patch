From bc1d479c8ef9c12d3e1b1e2a867fe508d7aab524 Mon Sep 17 00:00:00 2001
From: Jhuan Reategui Solis <reateguisolisjm@gmail.com>
Date: Mon, 1 Jun 2026 22:59:23 -0500
Subject: [PATCH 1/3] bluetooth: fix timing race y NAP UUID bloqueando BT
 enable en Y210
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

BluetoothEventLoop: reintentar en org.bluez.Error.NoSuchAdapter
  bluetoothd se registra en D-Bus antes de que hciattach complete;
  hci0 aparece milisegundos después. Sin este retry, el EventLoop
  desistía al primer NoSuchAdapter y apagaba el stack completo.

BluetoothService: NAP UUID condicional en mAdapterUuids
  setBluetoothTetheringNative falla en BlueZ 4.93 (sin NetworkServer).
  Al añadir NAP incondicionalmente a mAdapterUuids, la comprobación
  containsAllUuids nunca se cumplía y SERVICE_RECORD_LOADED nunca
  se enviaba, expirando PREPARE_BLUETOOTH_TIMEOUT con "SDP failed".

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
Change-Id: I4a478baea4a20269bbb8a0005b29101274a39b09
---
 core/java/android/server/BluetoothService.java | 9 +++++++--
 core/jni/android_server_BluetoothEventLoop.cpp | 6 ++++++
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/core/java/android/server/BluetoothService.java b/core/java/android/server/BluetoothService.java
index d1283bab220..185e633931a 100755
--- a/core/java/android/server/BluetoothService.java
+++ b/core/java/android/server/BluetoothService.java
@@ -570,13 +570,18 @@ public class BluetoothService extends IBluetooth.Stub {
         addReservedSdpRecords(uuids);
 
         // Enable profiles maintained by Bluez userspace.
-        setBluetoothTetheringNative(true, BluetoothPanProfileHandler.NAP_ROLE,
+        // On some devices (e.g. Y210 with BlueZ 4.93) NetworkServer is not available.
+        // Only add NAP to expected UUIDs if tethering registration succeeds.
+        boolean tetheringEnabled = setBluetoothTetheringNative(true,
+                BluetoothPanProfileHandler.NAP_ROLE,
                 BluetoothPanProfileHandler.NAP_BRIDGE);
 
         // Add SDP records for profiles maintained by Bluez userspace
         uuids.add(BluetoothUuid.AudioSource);
         uuids.add(BluetoothUuid.AvrcpTarget);
-        uuids.add(BluetoothUuid.NAP);
+        if (tetheringEnabled) {
+            uuids.add(BluetoothUuid.NAP);
+        }
 
         // Cannot cast uuids.toArray directly since ParcelUuid is parcelable
         mAdapterUuids = new ParcelUuid[uuids.size()];
diff --git a/core/jni/android_server_BluetoothEventLoop.cpp b/core/jni/android_server_BluetoothEventLoop.cpp
index 192e1e36d13..b8d2ac3616a 100644
--- a/core/jni/android_server_BluetoothEventLoop.cpp
+++ b/core/jni/android_server_BluetoothEventLoop.cpp
@@ -344,6 +344,12 @@ const char * get_adapter_path(DBusConnection *conn) {
                     LOG_AND_FREE_DBUS_ERROR(&err);
                     usleep(10000);  // 10 ms
                     continue;
+                } else if (dbus_error_has_name(&err,
+                    "org.bluez.Error.NoSuchAdapter")) {
+                    // bluetoothd up but hci0 not yet registered, retry
+                    LOG_AND_FREE_DBUS_ERROR(&err);
+                    usleep(10000);  // 10 ms
+                    continue;
                 } else {
                     // Some other error we weren't expecting
                     LOG_AND_FREE_DBUS_ERROR(&err);
-- 
