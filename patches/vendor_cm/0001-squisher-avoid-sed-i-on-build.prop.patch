From 0a73b8c3c9f5a3b8222b0d0ef145b2a8bcae8543 Mon Sep 17 00:00:00 2001
From: Juan Manuel Reategui Solis <reateguisolisjm@gmail.com>
Date: Sun, 18 Oct 2026 23:23:07 -0500
Subject: [PATCH] squisher: avoid sed -i on build.prop

sed -i replaces the file through a rename, which Docker Desktop shared
folders do not handle reliably (the container keeps resolving the old
inode). Write to a temp file and move it into place instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I33f2e052c2c141184aad25a5170027909a22816b
---
 tools/squisher | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/tools/squisher b/tools/squisher
index 552929ff..628d22d2 100755
--- a/tools/squisher
+++ b/tools/squisher
@@ -60,10 +60,11 @@ find ./ -name \*.apk | $XARGS $OPTICHARGER
 )
 
 # Fix build.prop
-$SED -i \
+$SED \
 	-e '/ro\.kernel\.android\.checkjni/d' \
 	-e '/ro\.build\.type/s/eng/user/' \
-	$REPACK/ota/system/build.prop
+	$REPACK/ota/system/build.prop > $REPACK/ota/system/build.prop.tmp
+mv $REPACK/ota/system/build.prop.tmp $REPACK/ota/system/build.prop
 
 
 # Delete unnecessary binaries
-- 
2.43.0

