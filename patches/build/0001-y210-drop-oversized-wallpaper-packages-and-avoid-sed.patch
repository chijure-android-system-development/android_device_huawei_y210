From 07238a282d2541eb9fa06fc3b9ac30254cca8510 Mon Sep 17 00:00:00 2001
From: Juan Manuel Reategui Solis <reateguisolisjm@gmail.com>
Date: Sun, 18 Oct 2026 23:04:53 -0500
Subject: [PATCH] y210: drop oversized wallpaper packages and avoid sed -i in
 recovery default.prop

The Y210 system partition cannot fit the default CM wallpaper and
live-wallpaper packages; filter them out after the product graph is
resolved (a filter-out in a device .mk is a silent no-op).

sed -i replaces the file through a rename, which Docker Desktop's
shared folders do not handle reliably; write to a temp file instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ia25efd9d8535316e28c3b69cced7b6b5791efa4c
---
 core/Makefile          |  3 ++-
 core/product_config.mk | 13 +++++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/core/Makefile b/core/Makefile
index cfcec33f1..8d39b96bc 100644
--- a/core/Makefile
+++ b/core/Makefile
@@ -770,7 +770,8 @@ $(TARGET_RECOVERY_ROOT_TIMESTAMP): $(INTERNAL_RECOVERY_FILES) \
 	cat $(INSTALLED_DEFAULT_PROP_TARGET) $(recovery_build_prop) \
 	        > $(TARGET_RECOVERY_ROOT_OUT)/default.prop
 	@echo Modifying default.prop
-	sed -i 's/ro.build.date.utc=.*/ro.build.date.utc=0/g' $(TARGET_RECOVERY_ROOT_OUT)/default.prop
+	sed 's/ro.build.date.utc=.*/ro.build.date.utc=0/g' $(TARGET_RECOVERY_ROOT_OUT)/default.prop > $(TARGET_RECOVERY_ROOT_OUT)/default.prop.tmp
+	mv $(TARGET_RECOVERY_ROOT_OUT)/default.prop.tmp $(TARGET_RECOVERY_ROOT_OUT)/default.prop
 	@echo "----- Made recovery filesystem --------" $(TARGET_RECOVERY_ROOT_OUT)
 	@touch $(TARGET_RECOVERY_ROOT_TIMESTAMP)
 
diff --git a/core/product_config.mk b/core/product_config.mk
index 3cb741ad5..febeff559 100644
--- a/core/product_config.mk
+++ b/core/product_config.mk
@@ -212,6 +212,19 @@ INTERNAL_PRODUCT := $(call resolve-short-product-name, $(TARGET_PRODUCT))
 # Find the device that this product maps to.
 TARGET_DEVICE := $(PRODUCTS.$(INTERNAL_PRODUCT).PRODUCT_DEVICE)
 
+# Y210's system partition is too small for all the default CM wallpaper/
+# live-wallpaper packages plus a working recovery.img. inherit-product's
+# PRODUCT_PACKAGES filtering only sees unexpanded @inherit: tags at parse
+# time (see node_fns.mk _expand-inherited-values), so a filter-out placed
+# in a device .mk file is a silent no-op; it has to run here, after the
+# product graph is fully resolved into literal module names.
+ifeq ($(TARGET_DEVICE),y210)
+PRODUCTS.$(INTERNAL_PRODUCT).PRODUCT_PACKAGES := \
+    $(filter-out CMWallpapers VideoEditor LiveWallpapers LiveWallpapersPicker \
+        MagicSmokeWallpapers Galaxy4 HoloSpiralWallpaper NoiseField PhaseBeam \
+        VisualizationWallpapers,$(PRODUCTS.$(INTERNAL_PRODUCT).PRODUCT_PACKAGES))
+endif
+
 # Figure out which resoure configuration options to use for this
 # product.
 PRODUCT_LOCALES := $(strip $(PRODUCTS.$(INTERNAL_PRODUCT).PRODUCT_LOCALES))
-- 
