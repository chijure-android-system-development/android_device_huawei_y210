From da0cd061d7dcad578521e008f8053662f6ead986 Mon Sep 17 00:00:00 2001
From: Juan Manuel Reategui Solis <reateguisolisjm@gmail.com>
Date: Sun, 18 Oct 2026 23:04:54 -0500
Subject: [PATCH] libril: board flags for the Huawei Y210 Qualcomm v6 blob

libril-qc-1.so (Y210 stock) declares RIL v6 but uses the layouts of the
stock Huawei/CAF libril, taken from disassembling the blob:

- BOARD_RIL_GET_IMSI_TAKES_AID: dispatch GET_IMSI as strings so the
  USIM AID reaches qcril_uim_request_get_imsi (NULL deref otherwise).
- BOARD_RIL_SIM_IO_LEADING_INT: pass RIL_SIM_IO_v6 behind one unused int
  (command at +4, aidPtr at +36, 40 bytes); with the plain v6 struct the
  blob read the AID off libril's stack and crashed in vfprintf.
- BOARD_RIL_DATA_CALL_RESPONSE_V5: the blob answers SETUP_DATA_CALL and
  DATA_CALL_LIST with the 32-byte struct without suggestedRetryTime;
  re-emit it in the v6 parcel layout.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ia8960039a6b9d52a496040b95068ad6a67376eeb
---
 libril/Android.mk     | 16 ++++++++++
 libril/ril.cpp        | 68 +++++++++++++++++++++++++++++++++++++++++++
 libril/ril_commands.h |  4 +++
 3 files changed, 88 insertions(+)

diff --git a/libril/Android.mk b/libril/Android.mk
index d1f3475..0120738 100644
--- a/libril/Android.mk
+++ b/libril/Android.mk
@@ -21,6 +21,22 @@ LOCAL_MODULE:= libril
 
 LOCAL_LDLIBS += -lpthread
 
+# Qualcomm v6 RILs (e.g. Huawei Y210 libril-qc-1) read the USIM AID from
+# GET_IMSI request data and crash on NULL; pass it through as strings.
+ifeq ($(BOARD_RIL_GET_IMSI_TAKES_AID),true)
+LOCAL_CFLAGS += -DRIL_GET_IMSI_TAKES_AID
+endif
+
+# ...and reads RIL_SIM_IO_v6 behind one leading int.
+ifeq ($(BOARD_RIL_SIM_IO_LEADING_INT),true)
+LOCAL_CFLAGS += -DRIL_SIM_IO_LEADING_INT
+endif
+
+# ...and answers data calls with the 32-byte pre-v6 struct.
+ifeq ($(BOARD_RIL_DATA_CALL_RESPONSE_V5),true)
+LOCAL_CFLAGS += -DRIL_DATA_CALL_RESPONSE_V5
+endif
+
 #USE HCRADIO
 ifeq ($(BOARD_USES_HC_RADIO),true)
 LOCAL_CFLAGS += -DHCRADIO
diff --git a/libril/ril.cpp b/libril/ril.cpp
index 861ab8b..6498a67 100644
--- a/libril/ril.cpp
+++ b/libril/ril.cpp
@@ -719,8 +719,24 @@ dispatchSIM_IO (Parcel &p, RequestInfo *pRI) {
         goto invalid;
     }
 
+#ifdef RIL_SIM_IO_LEADING_INT
+    {
+        /* Huawei Y210 libril-qc-1 reads RIL_SIM_IO_v6 shifted by one int
+         * (command at +4, aidPtr at +36); the leading word is unused. */
+        struct {
+            int unused;
+            RIL_SIM_IO_v6 v6;
+        } simIOq;
+
+        memset(&simIOq, 0, sizeof(simIOq));
+        simIOq.v6 = simIO.v6;
+        s_callbacks.onRequest(pRI->pCI->requestNumber, &simIOq,
+                sizeof(simIOq), pRI);
+    }
+#else
     size = (s_callbacks.version < 6) ? sizeof(simIO.v5) : sizeof(simIO.v6);
     s_callbacks.onRequest(pRI->pCI->requestNumber, &simIO, size, pRI);
+#endif
 
 #ifdef MEMSET_FREED
     memsetString (simIO.v6.path);
@@ -1533,6 +1549,58 @@ static int responseDataCallList(Parcel &p, void *response, size_t responselen)
             return RIL_ERRNO_INVALID_RESPONSE;
         }
 
+#ifdef RIL_DATA_CALL_RESPONSE_V5
+        {
+            /* Huawei Y210 libril-qc-1 reports RIL v6 but answers with the
+             * pre-v6 struct (no suggestedRetryTime, 32 bytes). Re-emit it
+             * in the v6 parcel layout so RILJ needs no special casing. */
+            typedef struct {
+                int status;
+                int cid;
+                int active;
+                char *type;
+                char *ifname;
+                char *addresses;
+                char *dnses;
+                char *gateways;
+            } RIL_Data_Call_Response_v5_qc;
+
+            if (responselen % sizeof(RIL_Data_Call_Response_v5_qc) != 0) {
+                LOGE("invalid response length %d expected multiple of %d",
+                        (int)responselen, (int)sizeof(RIL_Data_Call_Response_v5_qc));
+                return RIL_ERRNO_INVALID_RESPONSE;
+            }
+
+            int num = responselen / sizeof(RIL_Data_Call_Response_v5_qc);
+            p.writeInt32(num);
+
+            RIL_Data_Call_Response_v5_qc *p_cur = (RIL_Data_Call_Response_v5_qc *) response;
+            startResponse;
+            for (int i = 0; i < num; i++) {
+                p.writeInt32(p_cur[i].status);
+                p.writeInt32(-1); /* suggestedRetryTime: no suggestion */
+                p.writeInt32(p_cur[i].cid);
+                p.writeInt32(p_cur[i].active);
+                writeStringToParcel(p, p_cur[i].type);
+                writeStringToParcel(p, p_cur[i].ifname);
+                writeStringToParcel(p, p_cur[i].addresses);
+                writeStringToParcel(p, p_cur[i].dnses);
+                writeStringToParcel(p, p_cur[i].gateways);
+                appendPrintBuf("%s[status=%d,cid=%d,%s,%s,%s,%s,%s],", printBuf,
+                    p_cur[i].status,
+                    p_cur[i].cid,
+                    (p_cur[i].active==0)?"down":"up",
+                    (char*)p_cur[i].ifname,
+                    (char*)p_cur[i].addresses,
+                    (char*)p_cur[i].dnses,
+                    (char*)p_cur[i].gateways);
+            }
+            removeLastChar;
+            closeResponse;
+            return 0;
+        }
+#endif
+
         if (responselen % sizeof(RIL_Data_Call_Response_v6) != 0) {
             LOGE("invalid response length %d expected multiple of %d",
                     (int)responselen, (int)sizeof(RIL_Data_Call_Response_v6));
diff --git a/libril/ril_commands.h b/libril/ril_commands.h
index 68a8b31..ad83796 100644
--- a/libril/ril_commands.h
+++ b/libril/ril_commands.h
@@ -25,7 +25,11 @@
     {RIL_REQUEST_ENTER_NETWORK_DEPERSONALIZATION, dispatchStrings, responseInts},
     {RIL_REQUEST_GET_CURRENT_CALLS, dispatchVoid, responseCallList},
     {RIL_REQUEST_DIAL, dispatchDial, responseVoid},
+#ifdef RIL_GET_IMSI_TAKES_AID
+    {RIL_REQUEST_GET_IMSI, dispatchStrings, responseString},
+#else
     {RIL_REQUEST_GET_IMSI, dispatchVoid, responseString},
+#endif
     {RIL_REQUEST_HANGUP, dispatchInts, responseVoid},
     {RIL_REQUEST_HANGUP_WAITING_OR_BACKGROUND, dispatchVoid, responseVoid},
     {RIL_REQUEST_HANGUP_FOREGROUND_RESUME_BACKGROUND, dispatchVoid, responseVoid},
